# Settings come from the environment (docker-compose.yml, on the server /opt/lealink/.env):
# SITE_ADDRESS  hosts Caddy serves and gets HTTPS certificates for, e.g. "example.com, www.example.com".
#               Not set -> ":80": plain HTTP on any address (local development).
# SITE_DOMAIN   the main domain. Requests to any other host (www, the old nip.io address) are
#               redirected there. Not set -> no redirects.
{$SITE_ADDRESS::80} {
	encode gzip zstd

	@elsewhere expression `"{$SITE_DOMAIN}" != "" && {host} != "{$SITE_DOMAIN}"`
	redir @elsewhere https://{$SITE_DOMAIN}{uri} 308

	# Browsers remember to use HTTPS only (ignored on plain-HTTP local development).
	header Strict-Transport-Security "max-age=31536000"

	# Backend (FastAPI container "api"): /api/..., docs at /api/docs
	handle /api/* {
		reverse_proxy api:8000
	}

	# Static site. no-cache: browsers re-check files (cheap 304) so a deploy never mixes old and new JS.
	handle {
		root * /srv
		header Cache-Control "no-cache"
		file_server
	}
}
