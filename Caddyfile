# SITE_ADDRESS comes from the environment (docker-compose.yml).
# Not set   -> ":80": plain HTTP on any address (works by IP).
# A domain  -> Caddy serves it and gets an HTTPS certificate automatically.
{$SITE_ADDRESS::80} {
	encode gzip zstd

	# Backend (FastAPI container "api"): /api/..., docs at /api/docs
	handle /api/* {
		reverse_proxy api:8000
	}

	# Static site. no-cache: browsers re-check files (cheap 304) so a deploy never mixes old and new JS.
	handle {
		root * /srv
		header Cache-Control "no-cache"
		file_server
	}
}
